---
interface Props {
  title: string;
  description: string;
}

import "./src/styles/global.css";
import "../components/Navbar.astro";
const {
  title = "David Henery | Web Developer | Portfolio",
  description = "Portfolio of David Henery, a web developer specializing in modern, responsive websites, UI/UX design, and front-end development.",
} = Astro.props;
import Navbar from "../components/Navbar.astro";
import GradientStyles from "@components/GradientStyles.astro";
import Sidebar from "@components/Sidebar.astro";

//

import {} from "astro:transitions";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="web developer, portfolio, front-end, back-end, full-stack, UI design, responsive websites, PHP, JavaScript, Tailwind CSS, React, NextJS, mySQL, AstroJS, VueJS, Figma, Freelance Web Developer"
    />

    <style>
      @view-transition {
        navigation: auto;
      }
    </style>

    <!-- Scripts -->
    <script src="src/js/sidebar.ts"></script>
    <script src="src/js/gradient.ts"></script>

    <title>{title}</title>
  </head>
  <body class="relative min-h-[100svh] text-white">
    <div
      class="relative w-full lgDesktop:max-w-[1440px] lgDesktop:mx-auto lgDesktop:grid lgDesktop:grid-cols-LGDesktop lgDesktop:grid-rows-LGDesktop lgDesktop:pt-12"
    >
      <Navbar />
      <Sidebar />
      <slot />
    </div>
    <GradientStyles />
  </body>
</html>
