---
import Layout from "@layouts/Layout.astro";
import { Heading } from "@components/reusable/text";
import Form from "@components/contact/Form.astro";
---

<Layout
  title="Contact | David Henery | Web Developer"
  description="Get in touch with David Henery to start your next web project or collaboration. Reach out for freelance opportunities, inquiries, or just to say hello."
>
  <main
    class="w-full mx-auto max-w-[1440px] py-12 px-layout-mob mobile:px-layout-tab tablet:py-24 laptop:p-layout-lap desktop:p-layout-desk"
  >
    <Heading headingType="primary" classes={["text-center"]}> Contact </Heading>
    <Form />
  </main>
</Layout>
