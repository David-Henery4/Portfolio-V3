---
export const prerender = false;
import FiltersContainer from "@components/reusable/project-filters/FiltersContainer.astro";
import Layout from "@layouts/Layout.astro";
import { Heading } from "@components/reusable/text";
import type { ProjectType } from "src/types/projects-types";
import ProjectsContainer from "@components/projects/ProjectsContainer.astro";
// **** //

// Using try/catch for error handling
const res = await fetch("http://localhost:8000/api/projects");
const { docs } = await res.json();
const projectData: ProjectType[] = docs;


---

<Layout
  title="Projects | David Henery | Web Developer"
  description="Explore featured web development projects by David Henery, showcasing a range of projects, built with different modern technologies."
>
  <main
    class="w-full mx-auto max-w-[1440px] py-12 px-layout-mob mobile:px-layout-tab tablet:py-24 laptop:p-layout-lap desktop:p-layout-desk"
  >
    <Heading headingType="primary" classes={["text-center"]}>
      My Projects
    </Heading>

    <FiltersContainer projectData={projectData} />

    <ProjectsContainer />
  </main>
</Layout>
