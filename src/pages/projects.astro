---
import Layout from "@layouts/Layout.astro";
import { Heading } from "@components/reusable/text";
import ProjectCard from "@components/projects/ProjectCard.astro";
---

<Layout
  title="Projects | David Henery | Web Developer"
  description="Explore featured web development projects by David Henery, showcasing a range of projects, built with different modern technologies."
>
  <main class="w-full py-12 px-layout-mob mobile:px-layout-tab">
    <Heading headingType="primary" classes={["text-center"]}>
      My Projects
    </Heading>

    <div
      class="w-full max-w-lg mx-auto mt-16 text-sm flex flex-wrap justify-center items-center gap-x-4 gap-y-2"
    >
      <a href="#" class="hover:text-orange">Development</a>
      <a href="#" class="hover:text-orange">React</a>
      <a href="#" class="hover:text-orange">Design</a>
      <a href="#" class="hover:text-orange">NextJS</a>
      <a href="#" class="hover:text-orange">Full Stack</a>
    </div>

    <div
      class="w-full mt-8 grid grid-cols-projects justify-center gap-y-12 gap-x-8"
    >
      <ProjectCard />
      <ProjectCard />
      <ProjectCard />
      <ProjectCard />
      <ProjectCard />
      <ProjectCard />
    </div>
  </main>
</Layout>
