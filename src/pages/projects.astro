---
import Layout from "@layouts/Layout.astro";
import { Heading } from "@components/reusable/text";
import ProjectCard from "@components/projects/ProjectCard.astro";
---

<Layout
  title="Projects | David Henery | Web Developer"
  description="Explore featured web development projects by David Henery, showcasing a range of projects, built with different modern technologies."
>
  <main class="w-full py-12 px-6">
    <Heading headingType="primary" classes={["text-center"]}>
      My Projects
    </Heading>
    <div class="w-full mt-16 grid grid-cols-projects justify-center gap-y-12 gap-x-8">
      <ProjectCard />
      <ProjectCard />
      <ProjectCard />
      <ProjectCard />
      <ProjectCard />
      <ProjectCard />
    </div>
  </main>
</Layout>
