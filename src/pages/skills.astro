---
import Layout from "@layouts/Layout.astro";
import { Heading } from "@components/reusable/text";
import SkillContainer from "@components/skills/SkillContainer.astro";
import skillsData from "@local-data/skillsData";
---

<Layout
  title="Skills | David Henery | Web Developer"
  description="Find out about David Henery's web development skills, including front-end frameworks, back-end technologies, and UI/UX design tools used to craft modern, responsive websites."
>
  <main
    class="w-full mx-auto max-w-[1440px] py-12 px-layout-mob mobile:px-layout-tab tablet:py-24 laptop:p-layout-lap desktop:p-layout-desk"
  >
    <Heading headingType="primary" classes={["text-center"]}> Skills </Heading>
    <div class="w-full mt-10 grid gap-6 grid-cols-skills">
      {
        skillsData.map((skill) => {
          return <SkillContainer {...skill} />;
        })
      }
    </div>
  </main>
</Layout>
