---
import Layout from "@layouts/Layout.astro";
import { Image } from "astro:assets";
import aboutMeImageLg from "@assets/images/about-me-img-large.png";
import { Heading, BaseText } from "@components/reusable/text";
import { PrimaryButton, Socials } from "@components/reusable";
---

<Layout
  title="About Me | David Henery | Web Developer"
  description="Find out about David Henery, a web developer focused on building clean, responsive websites with great user experiences. Learn more about me, my journey, skills, and my values behind the code."
>
  <main
    class="w-full mx-auto max-w-[1440px] py-12 px-layout-mob flex flex-col justify-center items-center gap-10 mobile:px-layout-tab tablet:py-24 laptop:p-layout-lap desktop:flex-row-reverse desktop:gap-16 desktop:p-layout-desk desktop:h-svh desktop:max-h-[762px]"
  >
    <div class="fade-in-ani w-full max-w-[310px] mx-auto desktop:max-w-[375px]">
      <Image
        class="w-full object-cover object-center"
        src={aboutMeImageLg}
        alt="David Henery | Web Developer"
      />
    </div>

    <div class="about-body text-center desktop:text-left">
      <Heading headingType="primary"> About Me </Heading>

      <div class="w-full mt-6">
        <BaseText classes={["max-w-[495px]", "mx-auto"]}>
          I am a driven frontend developer with a love for exploring new
          technologies and putting them to use in creating one-of-a-kind digital
          experiences. I place a strong emphasis on creating responsive projects
          and have a sharp eye for detail to ensure a seamless user experience.
          When I'm not coding, I enjoy watching football, listening to music,
          reading, cooking and trying out spicy foods.
        </BaseText>

        <div
          class="w-full mt-8 flex flex-col justify-center items-center gap-8 small-tablet:flex-row small-tablet:gap-14 desktop:justify-start"
        >
          <PrimaryButton />

          <Socials />
        </div>
      </div>
    </div>
  </main>
</Layout>
