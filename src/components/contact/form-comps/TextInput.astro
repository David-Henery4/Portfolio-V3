---
interface Props {
  id: string;
  label: string;
  name: string;
  isTextarea?: boolean;
  classes?: string[];
}
const { id, label, name, isTextarea, classes } = Astro.props;
---

{
  isTextarea ? (
    <div
      class="relative w-full flex flex-col justify-center items-start"
      class:list={classes}
    >
      <textarea
        class="w-full peer min-h-64 py-2 px-4 rounded-sm resize-none outline-none bg-white/15 border-2 border-white/0 placeholder:capitalize"
        id={id}
        name={name}
        placeholder={name}
      />
      <label
        class="absolute text-orange capitalize left-[17px] text-xs -top-6 transition-all peer-placeholder-shown:top-[9px] peer-placeholder-shown:text-base peer-placeholder-shown:text-white peer-focus:-top-6 peer-focus:text-xs peer-focus:text-orange"
        for={id}
      >
        {label}*
      </label>
    </div>
  ) : (
    <div
      class="relative w-full flex flex-col justify-center items-start"
      class:list={classes}
    >
      <input
        class="peer w-full rounded-sm py-2 px-4 outline-none placeholder:capitalize bg-white/15 border-2 border-white/0"
        type="text"
        id={id}
        name={name}
        placeholder={name}
      />
      <label
        class="absolute text-orange capitalize left-[17px] text-xs -top-6 transition-all peer-placeholder-shown:top-[9px] peer-placeholder-shown:text-base peer-placeholder-shown:text-white peer-focus:-top-6 peer-focus:text-xs peer-focus:text-orange"
        for={id}
      >
        {label}*
      </label>
      {/* <p class="absolute -bottom-5 left-4 text-xs text-error-red font-semibold">
        Can't be empty
      </p> */}
    </div>
  )
}
