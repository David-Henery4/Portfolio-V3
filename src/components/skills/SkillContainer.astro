---
interface Props {
  id: number;
  name: string;
  value: string;
  icon: string;
}
const {icon, name, value} = Astro.props
---

<div class="p-5 h-52 flex flex-col justify-start items-center gap-4">
  <div class="w-20 h-20 rounded-full bg-bg1 grid place-items-center">{name}</div>
  <div class="w-32 h-[1%] bg-white/20"></div>
  <h4 class="text-xl h-[24.5%]">{name}</h4>
</div>
