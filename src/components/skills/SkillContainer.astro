---
interface Props {
  createdAt: string;
  updatedAt: string;
  title: string;
  skillIcon: string;
  id: string;
}
const { title, skillIcon } = Astro.props;
---

<div class="p-5 h-52 flex flex-col justify-start items-center gap-4">
  <Fragment set:html={skillIcon} />
  <div class="w-32 h-[1%] bg-white/20"></div>
  <h4 class="text-xl h-[24.5%]">{title}</h4>
</div>
