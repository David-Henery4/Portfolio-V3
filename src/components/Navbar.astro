---
import navdata from "@local-data/navdata.ts";
import logo from "../assets/icons/logo-red.png";
---

<nav
  class="w-full px-6 py-3 border-b border-white flex justify-between items-center"
>
  <div class="w-16 h-auto">
    <a href="/" aria-label="Go to homepage" title="Go to homepage">
      <span class="sr-only">Go to homepage</span>
      <img
        class="object-center object-cover"
        src={logo?.src}
        alt="David's personal logo"
      />
    </a>
  </div>

  <!-- <menu>
    
  </menu> -->

  <div class="w-9 h-6 hover:cursor-pointer">
    <svg
      class="w-full h-full"
      viewBox="0 0 36 29"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M2 2.15015H34M2 14.1501H34M2 26.1501H34"
        stroke="white"
        stroke-width="4"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </div>
</nav>
