---
// import projectImage from "@assets/placeholders/project-placeholder-image.png";
import { Image } from "astro:assets";
import ArrowRight from "@assets/icons/ArrowRight.astro";
import type { ProjectType } from "src/types/projects-types";

const { title, description, tags, projectRepo, projectUrl, projectImage } =
  Astro.props as ProjectType;
console.log(title);
---

<article class="w-full grid grid-rows-card">
  <figure class="w-full">
    <Image
      class="w-full h-64 object-center object-cover"
      src={`http://localhost:8000${projectImage?.url}`}
      width={750}
      height={640}
      alt="Screenshot of The Munch Hut project"
    />
  </figure>

  <div class="mt-4 grid grid-rows-cardContent">
    <h2 class="text-lg font-semibold">{title}</h2>

    <p class="text-sm mt-2 line-clamp-4">
      {description}
    </p>

    <div class="w-full flex flex-wrap gap-2 mt-4">
      {
        tags.map(({ category }) => {
          return (
            <p class="text-[10px] tracking-wide uppercase px-3 py-1.5 bg-white/30 inline rounded-4xl cursor-pointer hover:bg-white/85 hover:text-orange">
              {category}
            </p>
          );
        })
      }
    </div>

    <div class="w-full mt-5 flex justify-start items-center gap-6 text-sm self-end">
      <a
        class="inline-flex justify-center items-center gap-1 py-1 hover:text-orange"
        href={projectRepo}
      >
        Repo
        <span class="mt-1">
          <ArrowRight />
        </span>
      </a>
      <a
        href={projectUrl}
        class="bg-orange py-[6px] px-4 rounded-md hover:bg-orange-shade"
      >
        Live Project
      </a>
    </div>
  </div>
</article>
