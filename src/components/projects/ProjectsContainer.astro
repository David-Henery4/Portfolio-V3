---
import type { ProjectsAndPagData } from "src/types/projects-types";
import getProjects from "src/queries/getProjects";
import ProjectCard from "./ProjectCard.astro";
import Pagination from "./Pagination.astro";
//
const params = new URLSearchParams(Astro.url.searchParams);

const projectsData: ProjectsAndPagData | null = params
  ? await getProjects(params)
  : await getProjects();

// 98,95,100,91
// Preview/build version mobile: 97,95,100,100
// Preview/build version DESKTOP: 100,95,100,100
// Preview/build version LAPTOP: 100,95,100,100
// Preview/build version TABLET:  97,95,100,100


// THIS WHOLE PROJECT NEEDS TO BE DONE TOMORROW (Finished & deployed!)
---

{
  !projectsData ? (
    <div class="w-full py-20 text-center">
      <p>There has been an error, please try again later</p>
    </div>
  ) : (
    <div class="w-full mt-10 grid grid-cols-projects justify-center justify-items-center gap-y-12 gap-x-8">
      {projectsData?.docs ? (
        projectsData?.docs.map((project) => <ProjectCard {...project} />)
      ) : (
        <div>
          <p>No Projects found!</p>
        </div>
      )}
    </div>
  )
}

{projectsData && <Pagination {...projectsData} />}
