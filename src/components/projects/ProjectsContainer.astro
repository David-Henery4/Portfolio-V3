---
import type { ProjectType } from "src/types/projects-types";
import getProjects from "src/queries/getProjects";
import ProjectCard from "./ProjectCard.astro";
import Pagination from "./Pagination.astro";
//
const params = new URLSearchParams(Astro.url.searchParams);

interface ProjectsAndPagData {
  docs: ProjectType[];
  totalDocs: number | null;
  limit: number | null;
  totalPages: number | null;
  page: number | null;
  pagingCounter: number | null;
  hasPrevPage: boolean;
  hasNextPage: boolean;
  prevPage: number | null;
  nextPage: number | null;
}

let projectsData: ProjectsAndPagData;

if (params) {
  projectsData = await getProjects(params);
} else {
  projectsData = await getProjects();
}

const { docs: projectsList, ...pagData } = projectsData;

---

<div
  class="w-full mt-10 grid grid-cols-projects justify-center justify-items-center gap-y-12 gap-x-8"
>
  {
    projectsList ? (
      projectsList.map((project) => <ProjectCard {...project} />)
    ) : (
      <div>
        <p>No Projects found!</p>
      </div>
    )
  }
</div>

<Pagination {...pagData} />
