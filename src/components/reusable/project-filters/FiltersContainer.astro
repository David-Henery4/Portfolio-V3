---
import FilterBtn from "./btn/FilterBtn.astro";
import type { ProjectType } from "src/types/projects-types";

const res = await fetch("http://localhost:8000/api/projects");
const { docs } = await res.json();
const projectData: ProjectType[] = docs;

let allTags: string[] = [];

projectData.forEach((project) => {
  project.tags.forEach((tag) => {
    allTags = [...allTags, tag.category];
  });
});

const uniqueTags = [...new Set(allTags)];

---

<div
  class="filters w-full max-w-lg mx-auto mt-12 text-sm flex flex-wrap justify-center items-center gap-x-4 gap-y-2"
>
  {uniqueTags.map((category) => <FilterBtn category={category} />)}


</div>
