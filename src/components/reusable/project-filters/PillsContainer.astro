---
interface Props {
  tags: {
    category: string;
    id: string;
  }[];
}
import FilterBtn from "./btn/FilterBtn.astro";
const { tags } = Astro.props;
---

<div class="filters w-full flex flex-wrap gap-2 mt-4">
  {
    tags.map(({ category }) => <FilterBtn category={category} isPills={true} />)
  }
</div>
