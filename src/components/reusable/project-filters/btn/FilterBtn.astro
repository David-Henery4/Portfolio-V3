---
interface Props {
  category: string;
  isPills?: boolean;
}
const { category, isPills } = Astro.props;
const { searchParams } = Astro.url;

let isFilterActive = false;

searchParams
  .get("name")
  ?.split(",")
  .forEach((activeCategory) => {
    if (activeCategory === category) {
      isFilterActive = true;
    }
  });

const selectFilterTheme = () => {
  if (isPills) {
    const pillDefaults =
      "hover:text-orange hover:cursor-pointer text-[10px] tracking-wide uppercase px-3 py-1.5 inline rounded-4xl hover:bg-white/85";

    if (isFilterActive) {
      return `${pillDefaults} bg-orange`;
    }

    return `bg-white/30 ${pillDefaults}`;

  } else {
    return `hover:text-orange hover:cursor-pointer ${isFilterActive && "text-orange"}`;
  }
};
---

<button data-category={category} class={selectFilterTheme()}>
  {category}
</button>
