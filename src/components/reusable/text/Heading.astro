---
interface Props {
  headingType: "primary" | "secondary" | "third";
  classes?: string[];
}
const { headingType = "primary", classes } = Astro.props;
---

<!-- Might not need most of these -->{
  headingType === "primary" && (
    <h1 class:list={["text-5xl", "font-bold", "font-light", classes, "small-tablet:text-[64px]"]}>
      <slot />
    </h1>
  )
}

<!-- Might not need most of these -->
{
  headingType === "secondary" && (
    <h2>
      <slot />
    </h2>
  )
}
{
  headingType === "third" && (
    <h3>
      <slot />
    </h3>
  )
}
