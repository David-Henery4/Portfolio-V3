---
import getSocials from "../../queries/getSocials";
interface Props {
  classes?: string[];
}

const { isError, socialsList } = await getSocials();

const { classes } = Astro.props;
---

<div class="flex justify-center items-center gap-6">
  {
    isError ? (
      <span class="w-10 h-10 rounded-full bg-white/25" />
    ) : (
      socialsList.map((social) => {
        return (
          <a
            aria-label={social.name}
            target="_blank"
            rel="noopener noreferrer"
            href={social.link}
            class="w-10 h-10"
            class:list={classes}
          >
            <span class="sr-only">{social.name}</span>
            <Fragment set:html={social.icon} />
            {/* {<social.icon />} */}
          </a>
        );
      })
    )
  }
</div>
