---
import LogoIcon from "@assets/icons/LogoIcon.astro";
import CrossIcon from "@assets/icons/CrossIcon.astro";
import { Navigation } from "./reusable";
---

<aside
  id="sidebar"
  class="fixed top-0 left-0 z-50 w-full min-h-[100svh] bg-bg2 transition-all -translate-x-full invisible tablet:hidden"
>
  <div
    class="w-full px-6 py-4 flex justify-between items-center border-b border-white/25"
  >
    <LogoIcon />
    <CrossIcon />
  </div>

  <Navigation/>

</aside>
