---
import navdata from "@local-data/navdata";
import LogoIcon from "@assets/icons/LogoIcon.astro";
import CrossIcon from "@assets/icons/CrossIcon.astro";
const pathname = Astro.originPathname;
console.log(pathname);
---

<aside
  id="sidebar"
  class="fixed top-0 left-0 z-50 w-full min-h-[100svh] bg-bg2 transition-all -translate-x-full invisible"
>
  <div
    class="w-full px-6 py-4 flex justify-between items-center border-b border-white/25"
  >
    <LogoIcon />
    <CrossIcon />
  </div>

  <menu
    id="links-container"
    class="w-full px-6 py-12 text-3xl flex flex-col justify-start items-start gap-8"
  >
    {
      navdata.map((navItem) => {
        const activeLink = navItem.route === pathname;
        return (
          <li
            class={`link-item capitalize ${activeLink && "text-orange underline underline-offset-6"} hover:text-orange-shade`}
          >
            <a href={navItem.route}>{navItem.pageName}</a>
          </li>
        );
      })
    }
  </menu>
</aside>
