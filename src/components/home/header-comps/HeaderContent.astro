---
import { PrimaryButton, SecondaryButton } from "@components/reusable";
import Heading from "@components/reusable/text/Heading.astro";
---

<div class="w-full">
  <Heading
    headingType="primary"
    classes={[
      "inline-flex",
      "flex-col",
      "justify-center",
      "items-center",
      "gap-3",
    ]}
  >
    <span class="text-xl small-tablet:text-2xl">Hi, I’m David Henery</span>
    <span class="overflow-hidden h-20 words-container">
      <span class="block text-5xl font-bold small-tablet:text-[64px] word">
        Web Developer
      </span>
      <span class="block text-5xl font-bold small-tablet:text-[64px] word">
        Frontend Developer
      </span>
      <span class="block text-5xl font-bold small-tablet:text-[64px] word">
        Fallstack Developer
      </span>
      <span class="block text-5xl font-bold small-tablet:text-[64px] word">
        Backend Developer
      </span>
      <span class="block text-5xl font-bold small-tablet:text-[64px] word">
        Web Developer
      </span>
    </span>
    <span class="text-2xl small-tablet:text-4xl">I bring designs to life</span>
  </Heading>

  <div
    class="w-full mt-12 flex flex-wrap justify-center items-center gap-4 small-tablet:gap-8"
  >
    <PrimaryButton />
    <SecondaryButton />
  </div>
</div>
