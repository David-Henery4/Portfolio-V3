---
import { PrimaryButton, SecondaryButton } from "@components/reusable";
import Heading from "@components/reusable/text/Heading.astro";
---

<div class="w-full">
  <Heading
    headingType = "primary"
    classes={["inline-flex", "flex-col", "justify-center", "items-center", "gap-3"]}
  >
    <span class="text-xl">Hi, I’m David Henery</span>
    <span class="block text-5xl font-bold"> Web Developer </span>
    <span class="text-2xl">I bring designs to life</span>
  </Heading>

  <div class="w-full mt-12 flex justify-center items-center gap-4">
    <PrimaryButton />
    <SecondaryButton />
  </div>
</div>
