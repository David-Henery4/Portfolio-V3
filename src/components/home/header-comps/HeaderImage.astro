---
import headerImg from "@assets/images/header-img-cropped.png";
---

<div
  class="w-full flex items-center justify-center h-80 xtraSm:h-[400px] smTab:h-[480px] smDesk:h-full lrgDesk:h-[calc(100%-44px)] lrgDesk:mb-auto xtraLrgDesk:h-[calc(100%-64px)] relative"
>
  <div
    class="w-56 h-56 bg-orange smTab:h-80 smTab:w-80 relative header-circle group hover:w-[234px] hover:h-[234px] hover:smTab:w-[330px] hover:smTab:h-[330px] transition-all"
  >
    <div
      class="w-full h-96 relative bottom-11 scale-110 group-hover:scale-125 transition-all"
    >
      <img
        class="w-full h-full object-contain"
        src={headerImg.src}
        alt="header-profile-circle-img"
      />
    </div>
  </div>
</div>
