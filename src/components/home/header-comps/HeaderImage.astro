---
import headerImg from "@assets/images/header-img-cropped.png";
---

<div class="relative">
  <div
    class="circle-container opacity-0 w-full flex items-center justify-center h-80 xtraSm:h-[400px] smTab:h-[480px] smDesk:h-full lrgDesk:h-[calc(100%-44px)] lrgDesk:mb-auto xtraLrgDesk:h-[calc(100%-64px)] relative"
  >
    <div
      class="w-56 h-56 bg-orange smTab:h-80 smTab:w-80 relative header-circle group hover:w-[234px] hover:h-[234px] hover:smTab:w-[330px] hover:smTab:h-[330px] transition-all z-50"
    >
      <div
        class="w-full h-96 relative bottom-11 scale-110 group-hover:scale-125 transition-all"
      >
        <img
          class="image-left opacity-0 w-full h-full object-contain"
          src={headerImg.src}
          alt="header-profile-circle-img"
        />
      </div>
    </div>
    <span
      class="circle-dashed z-40 absolute w-60 h-60 top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-white border-dashed pointer-events-none"
    ></span>
  </div>
  <span
    class="circle-white z-40 absolute w-56 h-56 top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-white opacity-0 pointer-events-none"
  ></span>
</div>

